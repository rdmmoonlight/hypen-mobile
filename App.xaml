<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="HypenMaui.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:HypenMaui">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Definisi Key CardBackground untuk mengatasi StaticResource not found -->
            <Color x:Key="CardBackground">#1E1E1E</Color>

            <Color x:Key="PrimaryBackground">#0b0914</Color>
            <Color x:Key="CardBackground">#1E1E1E</Color>
            <Color x:Key="AccentCyan">#00E5FF</Color>
            <Color x:Key="AccentPink">#FF4081</Color>
            <Color x:Key="AccentPurple">#8A5CF5</Color>
        </ResourceDictionary>
    </Application.Resources>
    
</Application>
