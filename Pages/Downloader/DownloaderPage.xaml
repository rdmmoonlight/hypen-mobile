<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HypenMaui.Pages.Downloader.DownloaderPage"
             Title="Downloader"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Single Track Panel -->
            <Frame BackgroundColor="#1B1B1B" BorderColor="#2A2A2A" CornerRadius="8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Link Video Tunggal" TextColor="#8A8F98" FontSize="12" FontAttributes="Bold" />
                    <Entry x:Name="SingleUrlEntry"
                           Placeholder="URL YouTube / Music..."
                           PlaceholderColor="Gray"
                           TextColor="White"
                           Keyboard="Url" />
                    <Button x:Name="ExtractSingleButton"
                            Text="EKSTRAK LAGU"
                            BackgroundColor="#00E5FF"
                            TextColor="Black"
                            FontAttributes="Bold"
                            Clicked="OnExtractSingleClicked" />
                </VerticalStackLayout>
            </Frame>

            <!-- Playlist Panel -->
            <Frame BackgroundColor="#1B1B1B" BorderColor="#2A2A2A" CornerRadius="8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Link Playlist" TextColor="#8A8F98" FontSize="12" FontAttributes="Bold" />
                    <Entry x:Name="PlaylistUrlEntry"
                           Placeholder="URL Playlist YouTube..."
                           PlaceholderColor="Gray"
                           TextColor="White"
                           Keyboard="Url" />
                    <Button x:Name="ExtractPlaylistButton"
                            Text="EKSTRAK PLAYLIST"
                            BackgroundColor="#00E5FF"
                            TextColor="Black"
                            FontAttributes="Bold"
                            Clicked="OnExtractPlaylistClicked" />
                </VerticalStackLayout>
            </Frame>

            <!-- Status -->
            <Label x:Name="StatusLabel"
                   TextColor="#4CC9F0"
                   FontSize="13"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   IsVisible="False" />

            <!-- Terminal Log -->
            <Frame x:Name="TerminalFrame"
                   BackgroundColor="#050608"
                   BorderColor="#2A2A2A"
                   CornerRadius="8"
                   Padding="10"
                   IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="PROSES SERVER // LOG"
                               TextColor="#8A8F98"
                               FontSize="11"
                               FontAttributes="Bold" />
                        <Button Grid.Column="1"
                                x:Name="CancelButton"
                                Text="BATALKAN"
                                BackgroundColor="Transparent"
                                BorderColor="#FF5252"
                                BorderWidth="1"
                                TextColor="#FF5252"
                                FontSize="11"
                                Padding="10,4"
                                Clicked="OnCancelClicked" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#2A2A2A" />

                    <CollectionView x:Name="LogCollectionView"
                                    HeightRequest="280">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}"
                                       TextColor="#8A8F98"
                                       FontSize="11"
                                       FontFamily="Monospace"
                                       LineBreakMode="WordWrap"
                                       Padding="0,2" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
